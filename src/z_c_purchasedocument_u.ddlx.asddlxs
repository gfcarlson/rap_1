@Metadata.layer: #CORE
@UI: {
    headerInfo: {
        title: {
            value: 'PurchaseDocument',
            type: #STANDARD
        },
        description: {
            value: 'Description',
            type: #STANDARD
        },
        typeName: 'Purchase Document',
        typeNamePlural: 'Purchase Documents',
        imageUrl: 'PurchaseDocumentImageURL'
    }
}
annotate view Z_I_PurchaseDocument_U with
{
  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  PurchaseDocumentImageURL;

  @UI: {
    selectionField: [{ position: 10 }],
    facet: [
      {
        id: 'PurchaseDocumentCollectionFacet',
        type: #COLLECTION,
        label: 'Purchase Document',
        purpose: #STANDARD
      },
      {
        id: 'BasicDataFieldGroupReferenceFacet',
        type: #FIELDGROUP_REFERENCE,
        label: 'Basic Data',
        parentId: 'PurchaseDocumentCollectionFacet',
        targetQualifier: 'BasicDataFieldGroup',
        purpose: #STANDARD
      },
      {
        id: 'StatusDataFieldGroupReferenceFacet',
        type: #FIELDGROUP_REFERENCE,
        label: 'Status and Priority',
        parentId: 'PurchaseDocumentCollectionFacet',
        targetQualifier: 'StatusFieldGroup',
        purpose: #STANDARD
      },
      {
        id: 'PurchaseDocumentItemsLineItemReferenceFacet',
        type: #LINEITEM_REFERENCE,
        label: 'Purchase Document Items',
        targetElement: '_PurchaseDocumentItem',
        purpose: #STANDARD
      }
    ]
  }
  

  @UI: {
    lineItem: [{ position: 20, importance: #HIGH }],
    identification: [{ position: 10, importance: #HIGH }],
    fieldGroup: [{ qualifier: 'BasicDataFieldGroup', position: 10, importance: #HIGH }]
  }
  PurchaseDocument;

  @UI: {
    lineItem: [{ position: 30, importance: #HIGH }],
    identification: [{ position: 20, importance: #HIGH }],
    fieldGroup: [{ qualifier: 'BasicDataFieldGroup', position: 20, importance: #HIGH }]
  }
  Description;

  @UI: {
    lineItem: [{ position: 40, importance: #HIGH }],
    identification: [{ position: 30, importance: #HIGH }],
    selectionField: [{ position: 20 }],
    fieldGroup: [{ qualifier: 'StatusFieldGroup', position: 10, importance: #HIGH }],
    textArrangement: #TEXT_ONLY
  }
  Priority;

  @UI: {
    lineItem: [{ position: 50, importance: #HIGH, criticality: 'OverallPriceCriticality', criticalityRepresentation: #WITHOUT_ICON }],
    identification: [{ position: 40, importance: #HIGH }],
    fieldGroup: [{ qualifier: 'StatusFieldGroup', position: 20, importance: #HIGH }],
    dataPoint: { title: 'Overall Price', criticality: 'OverallPriceCriticality' }
  }
  OverallPrice;

  @UI: {
    lineItem: [{ position: 60, importance: #MEDIUM }],
    identification: [{ position: 50, importance: #MEDIUM }],
    selectionField: [{ position: 30 }],
    fieldGroup: [{ qualifier: 'StatusFieldGroup', position: 30, importance: #MEDIUM }],
    textArrangement: #TEXT_ONLY
  }
  Status;

  @UI: {
    lineItem: [{ position: 70, importance: #MEDIUM }],
    identification: [{ position: 60, importance: #MEDIUM }],
    selectionField: [{ position: 40 }],
    fieldGroup: [{ qualifier: 'BasicDataFieldGroup', position: 30, importance: #MEDIUM }]
  }
  PurchasingOrganization;

  @UI.hidden: true
  OverallPriceCriticality;

  @UI: {
    lineItem: [{ position: 80, importance: #LOW }],
    identification: [{ position: 70, importance: #LOW }],
    fieldGroup: [{ qualifier: 'BasicDataFieldGroup', position: 40, importance: #LOW }]
  }
  crea_date_time;

  @UI: {
    lineItem: [{ position: 90, importance: #LOW }],
    identification: [{ position: 80, importance: #LOW }],
    fieldGroup: [{ qualifier: 'BasicDataFieldGroup', position: 50, importance: #LOW }]
  }
  lchg_date_time;

  @UI: {
